# Enter these in Runflare service settings. This file is not loaded automatically.
RAMNOOR_HOST=0.0.0.0
PORT=8080
RAMNOOR_DB_PATH=/app/var/inventory.sqlite
RAMNOOR_AUTH_USER=choose-your-username
RAMNOOR_AUTH_PASSWORD=choose-your-password
# Optional: set your full public origin when the proxy changes the Host header.
# PUBLIC_ORIGIN=https://inventory.example.com

# Recommended for individual warehouse/project-control/admin accounts.
# Set in the hosting panel as JSON; replace names and all passwords.
# RAMNOOR_ACCOUNTS_JSON=[{"username":"warehouse1","password":"REPLACE_WITH_WAREHOUSE_PASSWORD","displayName":"Warehouse person","role":"warehouse"},{"username":"project1","password":"REPLACE_WITH_PROJECT_PASSWORD","displayName":"Project control person","role":"project_control"},{"username":"manager1","password":"REPLACE_WITH_ADMIN_PASSWORD","displayName":"Manager","role":"admin"}]
